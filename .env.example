# Copy this file to .env for local development. Replace every "replace-..." value.
# Never commit .env or production credentials.

# PostgreSQL / pgvector
POSTGRES_DB=enterprise_rag
POSTGRES_USER=enterprise_rag
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Published host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend application (Settings use the RAG_ prefix)
RAG_ENVIRONMENT=development
RAG_AUTO_CREATE_SCHEMA=true
RAG_JWT_SECRET=replace-with-at-least-32-random-bytes
RAG_JWT_TTL_MINUTES=30
RAG_COOKIE_SECURE=false
RAG_CORS_ORIGINS=["http://localhost:3000"]
RAG_ANSWER_PROVIDER=local
RAG_UPLOAD_MAX_BYTES=10485760
RAG_LOG_LEVEL=INFO

# Optional hosted answer providers. Leave keys empty while RAG_ANSWER_PROVIDER=local.
RAG_OPENAI_API_KEY=
RAG_OPENAI_MODEL=gpt-4o-mini
RAG_ANTHROPIC_API_KEY=
RAG_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Frontend value is compiled into the browser bundle during image build.
# The default same-origin path is proxied to the backend by Nginx.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
